@startuml
left to right direction
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam ArrowColor #000000
skinparam ActorBorderColor #000000
skinparam ActorBackgroundColor #EEEEEE
skinparam RectangleBorderColor #000000
skinparam RectangleFontStyle bold
skinparam usecase {
  BackgroundColor #EEF7EE
  BorderColor #2E7D32
}

actor "Staff" as Staff
actor "Admin" as Admin
actor "Member" as Member
actor "Super Admin" as Super

rectangle "FitGym Membership Management System" {
  ' Member
  usecase "Register Account" as M1
  usecase "Browse Gyms" as M2
  usecase "Generate Attendance\nQR Code" as M3
  usecase "View Attendance\nHistory" as M4
  usecase "Pay or Renew\nMembership" as M5
  usecase "View Payment\nHistory" as M6
  usecase "Book or Cancel\nClass" as M7
  usecase "Track Fitness\nProgress" as M8
  usecase "Submit Support\nTicket" as M9

  ' Staff (Admin can do these too)
  usecase "Scan Member QR\n(Check In / Out)" as S1
  usecase "View Members\nCurrently in Gym" as S2
  usecase "Register Walk-in\nMember" as S3
  usecase "Approve Pending\nMember" as S4
  usecase "Renew Membership\nand Record Payment" as S5
  usecase "View Expiring\nMemberships" as S6
  usecase "Manage Membership\nPlans" as S7
  usecase "Manage Class\nSchedule" as S8

  ' Everyone
  usecase "Log In" as C1
  usecase "Manage Profile\nand Password" as C2
  usecase "View Notifications" as C3

  ' Admin only
  usecase "Register Gym" as A1
  usecase "Manage Gym Info" as A2
  usecase "Manage Members" as A3
  usecase "Manage Staff Accounts" as A4
  usecase "Manage Staff\nAttendance and Schedule" as A5
  usecase "Manage Payments" as A6
  usecase "Generate and\nExport Reports" as A7
  usecase "Pay Gym\nSubscription" as A8

  ' Super Admin
  usecase "Approve or Reject\nSubscription Payment" as P1
  usecase "Manage Gyms" as P2
  usecase "Reset Gym Admin\nPassword" as P3
  usecase "Post Announcements" as P4
  usecase "View Platform\nAnalytics" as P5
  usecase "View Audit Logs" as P6

  usecase "Send SMS\nNotification" as SMS
}

' keep the use cases in one tidy column
M1 -[hidden]- M2
M2 -[hidden]- M3
M3 -[hidden]- M4
M4 -[hidden]- M5
M5 -[hidden]- M6
M6 -[hidden]- M7
M7 -[hidden]- M8
M8 -[hidden]- M9
M9 -[hidden]- S1
S1 -[hidden]- S2
S2 -[hidden]- S3
S3 -[hidden]- S4
S4 -[hidden]- S5
S5 -[hidden]- S6
S6 -[hidden]- S7
S7 -[hidden]- S8
S8 -[hidden]- C1
C1 -[hidden]- C2
C2 -[hidden]- C3
C3 -[hidden]- A1
A1 -[hidden]- A2
A2 -[hidden]- A3
A3 -[hidden]- A4
A4 -[hidden]- A5
A5 -[hidden]- A6
A6 -[hidden]- A7
A7 -[hidden]- A8
A8 -[hidden]- P1
P1 -[hidden]- P2
P2 -[hidden]- P3
P3 -[hidden]- P4
P4 -[hidden]- P5
P5 -[hidden]- P6
Member -[hidden]- Super

' Admin inherits everything Staff can do
Staff <|- Admin

' Left side: Staff and Admin
Staff --> S1
Staff --> S2
Staff --> S3
Staff --> S4
Staff --> S5
Staff --> S6
Staff --> S7
Staff --> S8
Staff --> C1
Staff --> C2
Staff --> C3

Admin --> A1
Admin --> A2
Admin --> A3
Admin --> A4
Admin --> A5
Admin --> A6
Admin --> A7
Admin --> A8

' Right side: Member and Super Admin
M1 <-- Member
M2 <-- Member
M3 <-- Member
M4 <-- Member
M5 <-- Member
M6 <-- Member
M7 <-- Member
M8 <-- Member
M9 <-- Member
C1 <-- Member
C2 <-- Member
C3 <-- Member

C1 <-- Super
C2 <-- Super
P1 <-- Super
P2 <-- Super
P3 <-- Super
P4 <-- Super
P5 <-- Super
P6 <-- Super

' include
M1 ..> SMS : <<include>>
A3 ..> SMS : <<include>>
S1 .> M3 : <<include>>
A8 .> P1 : <<include>>
@enduml
